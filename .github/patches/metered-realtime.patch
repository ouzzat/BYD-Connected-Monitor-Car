+import org.json.JSONArray
 import org.json.JSONObject
+import java.net.URLEncoder
+import java.util.concurrent.Executors
 import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+data class MeteredIceServer(
+    val urls: List<String>,
+    val username: String = "",
+    val credential: String = ""
+)
 
 class SignalClient(
-    private val url: String,
-    private val room: String,
+    private val publishableKey: String,
+    room: String,
     private val role: String,
     private val listener: Listener
 ) {
     interface Listener {
-        fun onOpen()
+        fun onOpen(iceServers: List<MeteredIceServer>)
         fun onMessage(message: JSONObject)
         fun onClosed(reason: String)
     }
 
+    companion object {
+        private const val ENDPOINT = "wss://rms.metered.ca/v1"
+    }
+
+    private val channel = "byd/${room.trim()}"
+    private val requestIds = AtomicLong(0)
+    private val reconnectScheduled = AtomicBoolean(false)
+    private val scheduler = Executors.newSingleThreadScheduledExecutor()
     private val http = OkHttpClient.Builder()
         .pingInterval(20, TimeUnit.SECONDS)
         .retryOnConnectionFailure(true)
         .build()
-    private var socket: WebSocket? = null
+
+    @Volatile private var socket: WebSocket? = null
+    @Volatile private var active = false
+    @Volatile private var retryDelaySeconds = 2L
+    @Volatile private var meteredIceServers: List<MeteredIceServer> = emptyList()
 
     fun connect() {
-        socket = http.newWebSocket(Request.Builder().url(url).build(), object : WebSocketListener() {
+        active = true
+        openSocket()
+    }
+
+    private fun openSocket() {
+        if (!active) return
+        reconnectScheduled.set(false)
+        val encodedKey = URLEncoder.encode(publishableKey, "UTF-8")
+        val request = Request.Builder().url("$ENDPOINT?key=$encodedKey").build()
+        socket = http.newWebSocket(request, object : WebSocketListener() {
             override fun onOpen(webSocket: WebSocket, response: Response) {
-                send(JSONObject().put("type", "join").put("room", room).put("role", role))
-                listener.onOpen()
+                retryDelaySeconds = 2L
             }
 
             override fun onMessage(webSocket: WebSocket, text: String) {
-                runCatching { JSONObject(text) }.onSuccess(listener::onMessage)
+                runCatching { JSONObject(text) }
+                    .onSuccess(::handleMeteredMessage)
+                    .onFailure { listener.onClosed("Réponse Metered invalide") }
             }
 
             override fun onClosed(webSocket: WebSocket, code: Int, reason: String) {
-                listener.onClosed(reason)
+                if (active) {
+                    listener.onClosed(reason.ifBlank { "connexion fermée ($code)" })
+                    scheduleReconnect()
+                }
             }
 
             override fun onFailure(webSocket: WebSocket, t: Throwable, response: Response?) {
-                listener.onClosed(t.message ?: "signalisation indisponible")
+                if (active) {
+                    listener.onClosed(t.message ?: "signalisation Metered indisponible")
+                    scheduleReconnect()
+                }
             }
         })
     }
 
+    private fun handleMeteredMessage(frame: JSONObject) {
+        when (frame.optString("type")) {
+            "welcome" -> {
+                meteredIceServers = parseIceServers(frame)
+                socket?.send(
+                    JSONObject()
+                        .put("type", "subscribe")
+                        .put("channel", channel)
+                        .put("requestId", "subscribe-${nextRequestId()}")
+                        .toString()
+                )
+            }
+            "ack" -> if (frame.optString("requestId").startsWith("subscribe-")) {
+                listener.onOpen(meteredIceServers)
+            }
+            "message" -> {
+                val data = frame.optJSONObject("data") ?: return
+                if (data.optString("from") != role) listener.onMessage(data)
+            }
+            "presence" -> {
+                val joined = frame.optJSONArray("joined")
+                if (joined != null && joined.length() > 0) {
+                    listener.onMessage(JSONObject().put("type", "peer-joined"))
+                }
+            }
+            "error" -> listener.onClosed(
+                "Metered ${frame.optString("code")}: ${frame.optString("message")}"
+            )
+            "going_away" -> listener.onClosed("Metered redémarre, reconnexion automatique")
+        }
+    }
+
+    private fun parseIceServers(frame: JSONObject): List<MeteredIceServer> {
+        val metadata = frame.optJSONObject("metadata")
+        val array = metadata?.optJSONArray("iceServers")
+            ?: frame.optJSONArray("iceServers")
+            ?: JSONArray()
+        return buildList {
+            for (index in 0 until array.length()) {
+                val item = array.optJSONObject(index) ?: continue
+                val urlsValue = item.opt("urls")
+                val urls = when (urlsValue) {
+                    is JSONArray -> buildList {
+                        for (urlIndex in 0 until urlsValue.length()) {
+                            urlsValue.optString(urlIndex).takeIf(String::isNotBlank)?.let(::add)
+                        }
+                    }
+                    is String -> listOf(urlsValue).filter(String::isNotBlank)
+                    else -> emptyList()
+                }
+                if (urls.isNotEmpty()) {
+                    add(
+                        MeteredIceServer(
+                            urls = urls,
+                            username = item.optString("username"),
+                            credential = item.optString("credential")
+                        )
+                    )
+                }
+            }
+        }
+    }
+
     fun send(message: JSONObject) {
-        message.put("room", room).put("from", role)
-        socket?.send(message.toString())
+        val data = JSONObject(message.toString()).put("from", role)
+        socket?.send(
+            JSONObject()
+                .put("type", "publish")
+                .put("channel", channel)
+                .put("data", data)
+                .put("requestId", "publish-${nextRequestId()}")
+                .toString()
+        )
+    }
+
+    private fun nextRequestId(): Long = requestIds.incrementAndGet()
+
+    private fun scheduleReconnect() {
+        if (!active || !reconnectScheduled.compareAndSet(false, true)) return
+        val delay = retryDelaySeconds
+        retryDelaySeconds = (retryDelaySeconds * 2).coerceAtMost(30L)
+        scheduler.schedule({ openSocket() }, delay, TimeUnit.SECONDS)
     }
 
     fun close() {
+        active = false
         socket?.close(1000, "arrêt")
         socket = null
+        scheduler.shutdownNow()
         http.dispatcher.executorService.shutdown()
     }
 }
